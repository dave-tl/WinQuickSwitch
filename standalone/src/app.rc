#include <windows.h>
#include "resource.h"

// Application manifest for DPI awareness and modern controls
1 RT_MANIFEST "..\\app.manifest"

// Version information
VS_VERSION_INFO VERSIONINFO
    FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
    PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "WinQuickSwitch"
            VALUE "FileDescription",  "Quick Virtual Desktop Switcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WinQuickSwitch"
            VALUE "OriginalFilename", "WinQuickSwitch.exe"
            VALUE "ProductName",      "WinQuickSwitch"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
